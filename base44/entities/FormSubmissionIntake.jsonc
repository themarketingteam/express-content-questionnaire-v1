{
  "name": "FormSubmissionIntake",
  "type": "object",
  "required": [
    "questionnaire_session_id"
  ],
  "properties": {
    "questionnaire_session_id": {
      "type": "string",
      "description": "Questionnaire session identifier used for recovery and deduplication"
    },
    "business_name": {
      "type": "string",
      "description": "Business name from the Express questionnaire session"
    },
    "business_domain": {
      "type": "string",
      "description": "Business domain from the Express questionnaire session"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user who submitted the questionnaire"
    },
    "user_id": {
      "type": "string",
      "description": "User ID of the submitter if available"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "received_intake",
        "retry_pending",
        "retry_success",
        "retry_failed",
        "abandoned"
      ],
      "default": "received_intake",
      "description": "Lifecycle status of this intake record"
    },
    "intake_reason": {
      "type": "string",
      "description": "Human-readable reason this intake record was created (e.g. zapier_timeout, db_error)"
    },
    "primary_failure_kind": {
      "type": "string",
      "description": "Category of the primary submission failure (e.g. zapier, db, network)"
    },
    "fallback_failure_kind": {
      "type": "string",
      "description": "Category of the fallback submission failure if the fallback path also failed"
    },
    "primary_error_json": {
      "type": "string",
      "description": "Serialized error from the primary submission attempt"
    },
    "fallback_error_json": {
      "type": "string",
      "description": "Serialized error from the fallback submission attempt"
    },
    "retry_error_json": {
      "type": "string",
      "description": "Serialized error from the most recent retry attempt"
    },
    "transformed_payload_json": {
      "type": "string",
      "description": "Serialized Express intake payload as mapped for submission (metadata + userdata structure)"
    },
    "raw_responses_json": {
      "type": "string",
      "description": "Serialized raw Express questionnaire responses at time of failure"
    },
    "diagnostics_json": {
      "type": "string",
      "description": "Serialized diagnostic context (user agent, page path, app version, timestamps)"
    },
    "source": {
      "type": "string",
      "description": "Source identifier for the intake record (e.g. express_questionnaire, admin_recovery)"
    },
    "created_at_client": {
      "type": "string",
      "description": "ISO 8601 timestamp from the client at time of failure"
    },
    "created_at_server": {
      "type": "string",
      "description": "ISO 8601 timestamp recorded server-side when the intake record was written"
    },
    "last_retry_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of the most recent retry attempt"
    },
    "retry_count": {
      "type": "number",
      "default": 0,
      "description": "Number of retry attempts made against this intake record"
    },
    "linked_submission_id": {
      "type": "string",
      "description": "ID of the FormSubmission record created on successful recovery or retry"
    },
    "zapier_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the Zapier webhook delivery has succeeded for this record"
    },
    "zapier_error_json": {
      "type": "string",
      "description": "Serialized Zapier delivery error if zapier_sent is false"
    },
    "notes": {
      "type": "string",
      "description": "Admin notes for recovery tracking or triage context"
    }
  },
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}