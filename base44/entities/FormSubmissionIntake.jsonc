{
  "name": "FormSubmissionIntake",
  "type": "object",
  "required": [
    "questionnaire_session_id"
  ],
  "properties": {
    "questionnaire_session_id": {
      "type": "string",
      "description": "Questionnaire session identifier used for recovery and deduplication"
    },
    "submit_attempt_id": {
      "type": "string",
      "description": "Client submit attempt id used for idempotency and support diagnostics"
    },
    "business_name": {
      "type": "string",
      "description": "Business name from the submission"
    },
    "business_domain": {
      "type": "string",
      "description": "Business domain from the submission"
    },
    "user_email": {
      "type": "string",
      "description": "User email if available"
    },
    "user_id": {
      "type": "string",
      "description": "User ID if available"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "received_intake",
        "auto_repair_pending",
        "retry_pending",
        "retry_success",
        "retry_failed",
        "abandoned"
      ],
      "default": "received_intake",
      "description": "Lifecycle status of the intake record"
    },
    "intake_reason": {
      "type": "string",
      "description": "Reason this intake record was created (e.g. form_submission_create_failed, payload_transform_failed)"
    },
    "primary_failure_kind": {
      "type": "string",
      "description": "Classified kind of the primary failure (e.g. timeout, network, server)"
    },
    "fallback_failure_kind": {
      "type": "string",
      "description": "Classified kind of the fallback failure if fallback also failed"
    },
    "primary_error_json": {
      "type": "string",
      "description": "Serialized primary error context"
    },
    "fallback_error_json": {
      "type": "string",
      "description": "Serialized fallback error context"
    },
    "retry_error_json": {
      "type": "string",
      "description": "Serialized error from the most recent retry attempt"
    },
    "transformed_payload_json": {
      "type": "string",
      "description": "Serialized transformed Express payload at time of intake"
    },
    "raw_responses_json": {
      "type": "string",
      "description": "Serialized raw Express questionnaire responses"
    },
    "diagnostics_json": {
      "type": "string",
      "description": "Serialized diagnostic metadata (browser, timing, context)"
    },
    "source": {
      "type": "string",
      "description": "Source context that triggered the intake (e.g. questionnaire_submit_fallback)"
    },
    "created_at_client": {
      "type": "string",
      "description": "ISO timestamp from the client at time of intake trigger"
    },
    "created_at_server": {
      "type": "string",
      "description": "ISO timestamp recorded by the server function"
    },
    "last_retry_at": {
      "type": "string",
      "description": "ISO timestamp of the last retry attempt"
    },
    "retry_count": {
      "type": "number",
      "default": 0,
      "description": "Number of retry attempts made"
    },
    "linked_submission_id": {
      "type": "string",
      "description": "FormSubmission record ID if a final submission was successfully created"
    },
    "zapier_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether a Zapier delivery has been triggered for this intake"
    },
    "zapier_error_json": {
      "type": "string",
      "description": "Serialized Zapier delivery error if zapier_sent failed"
    },
    "notes": {
      "type": "string",
      "description": "Admin notes for manual recovery tracking"
    },
    "ai_repair_status": {
      "type": "string",
      "description": "Status of the latest AI repair attempt. Values: not_started, diagnosed, repaired, retried, applied, failed."
    },
    "ai_repair_attempt_count": {
      "type": "number",
      "default": 0
    },
    "last_ai_repair_at": {
      "type": "string",
      "format": "date-time"
    },
    "ai_repair_error_json": {
      "type": "string",
      "description": "JSON string containing the last AI repair error."
    },
    "ai_repair_report_json": {
      "type": "string",
      "description": "JSON string containing AI repair diagnostics and changed paths."
    },
    "ai_repaired_payload_json": {
      "type": "string",
      "description": "JSON string containing the repaired Express payload."
    },
    "ai_repair_applied": {
      "type": "boolean",
      "default": false
    },
    "ai_repair_retry_attempted": {
      "type": "boolean",
      "default": false
    },
    "ai_repair_retry_result_json": {
      "type": "string",
      "description": "JSON string containing the result of a retry attempt after AI repair."
    },
    "ai_repair_source": {
      "type": "string",
      "description": "How the repair was performed: deterministic, ai, deterministic_plus_ai, or manual."
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether this intake has moved out of the active recovery set"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the intake was archived"
    },
    "active_investigation": {
      "type": "boolean",
      "default": false,
      "description": "Prevents automated archival or deletion while support is investigating"
    },
    "legal_hold": {
      "type": "boolean",
      "default": false,
      "description": "Prevents automated archival or deletion for a legal hold"
    },
    "retention_hold": {
      "type": "boolean",
      "default": false,
      "description": "Prevents automated archival or deletion for an explicit retention request"
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
