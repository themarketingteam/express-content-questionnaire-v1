{
  "name": "SubmissionPdfVersion",
  "type": "object",
  "required": [
    "draft_id",
    "payload_hash",
    "pdf_filename",
    "template_version",
    "version_number"
  ],
  "properties": {
    "draft_id": {
      "type": "string",
      "description": "FormDraft record that owns this saved PDF version"
    },
    "questionnaire_session_id": {
      "type": "string",
      "description": "Stable questionnaire session ID"
    },
    "submission_id": {
      "type": "string",
      "description": "FormSubmission record used for this PDF, when available"
    },
    "submit_attempt_id": {
      "type": "string",
      "description": "Submit attempt ID represented by this PDF"
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 fingerprint of all values rendered into the PDF"
    },
    "payload_source": {
      "type": "string",
      "description": "Payload source used for generation, such as mapped_payload_json or form_submission"
    },
    "payload_json": {
      "type": "string",
      "description": "Deprecated legacy payload snapshot; new versions store only payload_hash"
    },
    "source_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the source draft or submission used for generation"
    },
    "pdf_file_url": {
      "type": "string",
      "format": "uri",
      "description": "Deprecated legacy public URL; migrated versions use pdf_file_uri"
    },
    "pdf_file_uri": {
      "type": "string",
      "description": "Base44 private file URI; never sent directly to the browser"
    },
    "storage_visibility": {
      "type": "string",
      "enum": [
        "private",
        "legacy_public"
      ],
      "description": "Storage protection state for this PDF version"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Unique logical key composed from draft, payload hash, and template version"
    },
    "pdf_filename": {
      "type": "string",
      "description": "Download filename for this PDF"
    },
    "pdf_byte_size": {
      "type": "integer",
      "minimum": 0,
      "description": "Generated PDF file size in bytes"
    },
    "template_version": {
      "type": "string",
      "description": "Version of the Express PDF template used"
    },
    "version_number": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonically increasing version number within the draft"
    },
    "business_name": {
      "type": "string",
      "description": "Business name rendered in the PDF"
    },
    "business_domain": {
      "type": "string",
      "description": "Business domain rendered in the PDF"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this PDF version was generated and saved"
    },
    "s3_object_key": {
      "type": "string",
      "description": "Private AWS S3 object key used after independent storage migration"
    },
    "s3_object_version_id": {
      "type": "string",
      "description": "AWS S3 object version identifier"
    },
    "s3_object_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 checksum of the encrypted private PDF object plaintext"
    },
    "retention_policy": {
      "type": "string",
      "enum": ["indefinite_until_manual_deletion"],
      "default": "indefinite_until_manual_deletion"
    },
    "retention_policy_version": {
      "type": "string",
      "default": "2026-08-18"
    },
    "retention_protected_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
