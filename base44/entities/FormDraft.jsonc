{
  "name": "FormDraft",
  "type": "object",
  "required": [
    "session_id"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Stable questionnaire session ID"
    },
    "draft_access_key_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hash of the client-held secret used to access this draft"
    },
    "business_name": {
      "type": "string",
      "description": "Business name associated with the draft"
    },
    "domain": {
      "type": "string",
      "description": "Business domain associated with the draft"
    },
    "user_id": {
      "type": "string",
      "description": "Client user ID if available"
    },
    "user_name": {
      "type": "string",
      "description": "Client user name if available"
    },
    "user_email": {
      "type": "string",
      "description": "Client user email if available"
    },
    "status": {
      "type": "string",
      "description": "Draft lifecycle status"
    },
    "current_question_id": {
      "type": "string",
      "description": "Currently active question ID"
    },
    "last_changed_question_id": {
      "type": "string",
      "description": "Last changed question ID"
    },
    "responses_json": {
      "type": "string",
      "description": "Serialized Express questionnaire responses"
    },
    "validation_status_json": {
      "type": "string",
      "description": "Serialized validation status map"
    },
    "touched_questions_json": {
      "type": "string",
      "description": "Serialized touched questions map"
    },
    "expanded_questions_json": {
      "type": "string",
      "description": "Serialized expanded questions map"
    },
    "metadata_json": {
      "type": "string",
      "description": "JSON string of mapped final payload metadata"
    },
    "userdata_json": {
      "type": "string",
      "description": "JSON string of mapped final payload userdata"
    },
    "mapped_payload_json": {
      "type": "string",
      "description": "JSON string of full mapped final-style Express questionnaire payload"
    },
    "payload_edited_at": {
      "type": "string",
      "format": "date-time",
      "description": "When an administrator last changed the normalized payload"
    },
    "draft_metadata_json": {
      "type": "string",
      "description": "Technical draft autosave metadata such as page path, source, app name, and user agent"
    },
    "save_error": {
      "type": "string",
      "description": "Latest draft save error message"
    },
    "submit_error": {
      "type": "string",
      "description": "Latest submit error payload"
    },
    "submit_attempted_at": {
      "type": "string",
      "description": "When final submit was attempted"
    },
    "submitted_at": {
      "type": "string",
      "description": "When final submit succeeded"
    },
    "last_changed_at": {
      "type": "string",
      "description": "When the last answer changed"
    },
    "last_saved_at": {
      "type": "string",
      "description": "When the draft was last saved"
    },
    "last_non_empty_answers_json": {
      "type": "string",
      "description": "Serialized last-known non-empty answer values used for field recovery"
    },
    "field_history_json": {
      "type": "string",
      "description": "Serialized field-level answer history used for recovery"
    },
    "last_local_persisted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this state was most recently persisted in the client browser"
    },
    "final_submission_id": {
      "type": "string",
      "description": "Linked final FormSubmission ID"
    },
    "ai_repair_status": {
      "type": "string",
      "description": "Status of the latest AI repair attempt. Values: not_started, diagnosed, repaired, applied, failed."
    },
    "ai_repair_attempt_count": {
      "type": "number",
      "default": 0
    },
    "last_ai_repair_at": {
      "type": "string",
      "format": "date-time"
    },
    "ai_repair_error_json": {
      "type": "string",
      "description": "JSON string containing the last AI repair error."
    },
    "ai_repair_report_json": {
      "type": "string",
      "description": "JSON string containing AI repair diagnostics and changed paths."
    },
    "ai_repaired_payload_json": {
      "type": "string",
      "description": "JSON string containing the repaired Express payload."
    },
    "ai_repair_applied": {
      "type": "boolean",
      "default": false
    },
    "ai_repair_source": {
      "type": "string",
      "description": "How the repair was performed: deterministic, ai, deterministic_plus_ai, or manual."
    },
    "submit_attempt_id": {
      "type": "string",
      "description": "Latest client submit attempt identifier persisted with this draft"
    },
    "idempotency_lock_token": {
      "type": "string",
      "description": "Short-lived compare-and-set lease token for serialized writes"
    },
    "idempotency_lock_key": {
      "type": "string",
      "description": "Operation currently holding the serialized-write lease"
    },
    "idempotency_lock_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Expiry for the serialized-write lease"
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
