{
  "name": "FormSubmission",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string",
      "description": "Name of the business submitting the form"
    },
    "business_domain": {
      "type": "string",
      "description": "Business domain from the submission"
    },
    "user_email": {
      "type": "string",
      "description": "Submitting user email when captured"
    },
    "submission_datetime": {
      "type": "string",
      "description": "DateTime of submission in ET"
    },
    "service_type": {
      "type": "string",
      "description": "Type of service requested"
    },
    "it_company_type": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Types of IT company selected"
    },
    "it_company_type_other": {
      "type": "string",
      "description": "Other IT company type specified"
    },
    "service_offerings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Primary service offerings"
    },
    "service_offerings_other": {
      "type": "string",
      "description": "Other service offerings specified"
    },
    "differentiation": {
      "type": "string",
      "description": "What makes the company different"
    },
    "geographic_areas": {
      "type": "string",
      "description": "Geographic area served"
    },
    "geographic_area_meta": {
      "type": "object",
      "description": "Metadata about geographic location",
      "properties": {
        "label": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "place_id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "pricing_packaging": {
      "type": "string",
      "description": "Pricing/packaging model"
    },
    "pricing_packaging_other": {
      "type": "string",
      "description": "Other pricing model specified"
    },
    "company_goals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Company goals for next year"
    },
    "company_goals_other": {
      "type": "string",
      "description": "Other company goals specified"
    },
    "brand_tone": {
      "type": "string",
      "description": "Desired brand tone"
    },
    "brand_tone_other": {
      "type": "string",
      "description": "Other brand tone specified"
    },
    "target_industries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Target industries served"
    },
    "target_industries_other": {
      "type": "string",
      "description": "Other industries specified"
    },
    "client_size": {
      "type": "string",
      "description": "Typical client company size"
    },
    "client_challenges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Main IT challenges clients face"
    },
    "client_challenges_other": {
      "type": "string",
      "description": "Other client challenges specified"
    },
    "client_outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Desired client outcomes"
    },
    "client_outcomes_other": {
      "type": "string",
      "description": "Other client outcomes specified"
    },
    "ideal_client": {
      "type": "string",
      "description": "Description of ideal client"
    },
    "raw_responses_json": {
      "type": "string",
      "description": "Complete raw questionnaire response snapshot retained without requiring authentication"
    },
    "transformed_payload_json": {
      "type": "string",
      "description": "Complete normalized submission payload snapshot"
    },
    "questionnaire_session_id": {
      "type": "string",
      "description": "Stable questionnaire recovery/session id"
    },
    "submit_attempt_id": {
      "type": "string",
      "description": "Client submit attempt id used for idempotency and diagnostics"
    },
    "submission_fingerprint": {
      "type": "string",
      "description": "SHA-256 digest of normalized client identity and the complete raw response snapshot used for exact idempotency"
    },
    "identity_fingerprint": {
      "type": "string",
      "description": "SHA-256 digest of normalized business name and domain used to prevent cross-client session deduplication"
    },
    "zapier_delivery_status": {
      "type": "string",
      "enum": [
        "not_attempted",
        "sent",
        "failed"
      ],
      "description": "Delivery status for the downstream Express Zapier webhook"
    },
    "zapier_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the downstream Express Zapier webhook was successfully delivered"
    },
    "zapier_sent_at": {
      "type": "string",
      "description": "ISO timestamp when Zapier delivery succeeded"
    },
    "zapier_error_json": {
      "type": "string",
      "description": "Safe serialized Zapier delivery error if delivery failed"
    },
    "zapier_attempt_count": {
      "type": "number",
      "default": 0,
      "description": "Number of Zapier delivery attempts for this submission"
    },
    "resubmit_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times this submission has been resubmitted to Zapier via admin retry"
    },
    "linked_draft_id": {
      "type": "string",
      "description": "FormDraft record that owns this submission when a deterministic relationship exists"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "active_investigation": {
      "type": "boolean",
      "default": false
    },
    "legal_hold": {
      "type": "boolean",
      "default": false
    },
    "retention_hold": {
      "type": "boolean",
      "default": false
    },
    "retention_policy": {
      "type": "string",
      "enum": [
        "indefinite_until_manual_deletion"
      ],
      "default": "indefinite_until_manual_deletion"
    },
    "retention_policy_version": {
      "type": "string",
      "default": "2026-08-18"
    },
    "retention_protected_at": {
      "type": "string",
      "format": "date-time"
    },
    "questionnaire_payload_version": {
      "type": "integer",
      "enum": [
        1,
        2
      ],
      "description": "Absent or 1 is legacy; 2 includes an optional authoritative page structure."
    },
    "service_offerings_structure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "page-tree-v1"
          ]
        },
        "pages": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "source": {
                "type": "string",
                "enum": [
                  "predefined",
                  "custom"
                ]
              },
              "catalogId": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 2000
              },
              "children": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "predefined",
                        "custom"
                      ]
                    },
                    "catalogId": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 2000
                    },
                    "children": {
                      "type": "array",
                      "maxItems": 0,
                      "items": {
                        "type": "object"
                      }
                    }
                  },
                  "required": [
                    "label",
                    "source"
                  ]
                }
              }
            },
            "required": [
              "label",
              "source"
            ]
          }
        }
      },
      "required": [
        "format",
        "pages"
      ],
      "description": "Optional authoritative mapped page tree. Array position is sibling priority. New pages contain label and source, with children only for nonempty parents; optional historical id/catalogId and empty children remain readable."
    },
    "target_industries_structure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "page-tree-v1"
          ]
        },
        "pages": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "source": {
                "type": "string",
                "enum": [
                  "predefined",
                  "custom"
                ]
              },
              "catalogId": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 2000
              },
              "children": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "predefined",
                        "custom"
                      ]
                    },
                    "catalogId": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 2000
                    },
                    "children": {
                      "type": "array",
                      "maxItems": 0,
                      "items": {
                        "type": "object"
                      }
                    }
                  },
                  "required": [
                    "label",
                    "source"
                  ]
                }
              }
            },
            "required": [
              "label",
              "source"
            ]
          }
        }
      },
      "required": [
        "format",
        "pages"
      ],
      "description": "Optional authoritative mapped page tree. Array position is sibling priority. New pages contain label and source, with children only for nonempty parents; optional historical id/catalogId and empty children remain readable."
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
